{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "blankie episode-matching test cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "normalization", "matching"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "normalization": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "input": { "type": "string" },
          "expected": { "type": "string" }
        }
      }
    },
    "matching": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "episode", "candidates", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "note": { "type": "string" },
          "episode": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "airDate"],
            "properties": {
              "title": { "type": "string" },
              "airDate": { "$ref": "#/$defs/date" },
              "hints": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "publicGuid": { "type": "string" },
                  "patreonPostId": { "type": "string" }
                }
              }
            }
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["guid", "title", "pubDate"],
              "properties": {
                "guid": { "type": "string" },
                "title": { "type": "string" },
                "pubDate": { "$ref": "#/$defs/date" }
              }
            }
          },
          "expected": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
